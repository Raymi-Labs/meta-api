# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db

# 模型上下文及输入/输出模态：主节点启动一分钟后同步，此后默认每24小时检查。
# 复用 SYNC_UPSTREAM_BASE 的 /api/all.json；只补空或更新仍由自动同步维护的字段。
# MODEL_METADATA_SYNC_ENABLED=true
# MODEL_METADATA_SYNC_INTERVAL_HOURS=24
# SYNC_UPSTREAM_BASE=https://basellm.github.io/llm-metadata
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# 页面与构建静态资源分别按 IP 限流（静态资源默认不限次数）
# GLOBAL_WEB_RATE_LIMIT_ENABLE=true
# GLOBAL_WEB_RATE_LIMIT=60
# GLOBAL_WEB_RATE_LIMIT_DURATION=180
# GLOBAL_STATIC_RATE_LIMIT_ENABLE=false
# GLOBAL_STATIC_RATE_LIMIT=1000
# GLOBAL_STATIC_RATE_LIMIT_DURATION=180

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string

# Meta Pulse 集成（生产环境必须使用强随机密钥；不要提交真实密钥）
# 以下接入、SSO、日志保护、到账开关与额度上限可在「系统设置 → 配置 Meta Pulse 对接」设置。
# 页面仅保存修改的字段：已保存字段优先，未设置字段继续回退到环境变量；保留原有后台配置。
# 页面密钥留空表示保留，明确清除后不会回退到环境变量中的旧值；请沿用已有密钥，不要重置整套配置。
# 保存请求所在实例立即生效，其他实例按 SYNC_FREQUENCY 同步（默认 60 秒）；升级新版本仍需部署。
# 若通过 Compose 注入环境变量，须配置 env_file 或 environment，仅修改 .env 不保证传入容器。
# 完整配置、角色对照与轮换方法见 docs/META_PULSE.md。
# PULSE_ENV=production
# PULSE_SERVICE_HMAC_SECRET=
# PULSE_SERVICE_HMAC_SECRET_PREVIOUS=  # 轮换窗口：全部发送方切换后清空
# PULSE_INTERNAL_URL=http://pulse-api:8088
# PULSE_USAGE_LOG_REQUIRED=true  # Pulse 依赖 LOG_DB 时必须保持消费日志开启
# 新发奖默认关闭；启用时以下三个额度上限均须填写正整数 quota（不代表人民币）
# PULSE_BENEFIT_ENABLED=false
# PULSE_BENEFIT_MAX_GRANT_QUOTA=
# PULSE_BENEFIT_USER_DAILY_QUOTA=
# PULSE_BENEFIT_DAILY_QUOTA=
# 独立撤销密钥，禁止与发奖密钥复用；发奖 worker 不应持有
# PULSE_ROLLBACK_HMAC_SECRET=
# PULSE_ROLLBACK_HMAC_SECRET_PREVIOUS=
# 付费资格与升级次序见 docs/PULSE_FUNDING_PROVENANCE.md
# PULSE_USER_BFF_HMAC_SECRET=
# PULSE_ADMIN_HMAC_SECRET=
# PULSE_FORUM_SSO_SECRET=
# PULSE_FORUM_SSO_SECRET_PREVIOUS=  # 轮换窗口：论坛插件切换后清空
# PULSE_FORUM_SSO_CALLBACK_URL=https://forum.example.com/api/user-center/login/callback
# Benefit 内部接口限流仍通过部署环境设置（按已验签服务身份，不受公共 API IP 限流影响）
# PULSE_BENEFIT_RATE_LIMIT_ENABLE=true
# PULSE_BENEFIT_RATE_LIMIT=600       # 默认每个服务身份每 60 秒
# PULSE_BENEFIT_RATE_LIMIT_DURATION=60
# Pulse 与社区插件仍须分别配置各自参数；社区请求密钥不属于 new-api 配置。

# 请求最终失败日志默认开启，也可在管理面板的日志设置中修改。面板已保存的设置优先。
# ERROR_LOG_ENABLED=true

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
