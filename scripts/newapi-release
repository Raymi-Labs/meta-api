#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

APP_DIR="${NEWAPI_APP_DIR:-/opt/newapi}"
COMPOSE_FILE="${NEWAPI_COMPOSE_FILE:-$APP_DIR/docker-compose.yml}"
SERVICE_NAME="${NEWAPI_SERVICE_NAME:-new-api}"
CONTAINER_NAME="${NEWAPI_CONTAINER_NAME:-new-api-master}"
MYSQL_CONTAINER="${NEWAPI_MYSQL_CONTAINER:-newapi-mysql}"
DOCKER_NETWORK="${NEWAPI_DOCKER_NETWORK:-newapi_default}"
IMAGE_REPOSITORY="${NEWAPI_IMAGE_REPOSITORY:-ghcr.io/nanashiwang/new-api}"
GITHUB_REPOSITORY="${NEWAPI_GITHUB_REPOSITORY:-nanashiwang/new-api}"
BACKUP_ROOT="${NEWAPI_BACKUP_ROOT:-$APP_DIR/backups/one-click}"
STATE_DIR="${NEWAPI_STATE_DIR:-$APP_DIR/.release-manager}"
STATE_FILE="$STATE_DIR/state.env"
HISTORY_FILE="$STATE_DIR/history.tsv"
LOCK_FILE="${NEWAPI_LOCK_FILE:-/run/newapi-release.lock}"
HEALTH_URL="${NEWAPI_HEALTH_URL:-http://127.0.0.1:3000/api/status}"
HEALTH_TIMEOUT="${NEWAPI_HEALTH_TIMEOUT:-120}"
RESTART_STOP_TIMEOUT="${NEWAPI_RESTART_STOP_TIMEOUT:-30}"
PREFLIGHT_PASSES="${NEWAPI_PREFLIGHT_PASSES:-2}"
MIN_FREE_KB="${NEWAPI_MIN_FREE_KB:-2097152}"

TARGET_IMAGE=""
TARGET_ID=""
TARGET_VERSION=""
PREFLIGHT_DB=""
PREFLIGHT_USER=""
PREFLIGHT_CONTAINER=""
PREFLIGHT_WORK_DIR=""
RECOVERY_REQUIRED=0
RECOVERY_COMPOSE=""
RECOVERY_IMAGE=""
RECOVERY_ID=""
RECOVERY_STATE_SNAPSHOT=""
RECOVERY_STATE_EXISTED=0
CURRENT_IMAGE=""
CURRENT_ID=""
CURRENT_VERSION=""
PREVIOUS_IMAGE=""
PREVIOUS_ID=""
PREVIOUS_VERSION=""
LAST_BACKUP_DIR=""

timestamp_iso() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

log() {
  printf '[%s] %s\n' "$(timestamp_iso)" "$*"
}

die() {
  log "ERROR: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  newapi-update [latest|sha-abcdefg] [--dry-run]
  newapi-rollback [--dry-run]
  newapi-restart [--dry-run]
  newapi-release status
  newapi-release init [sha-abcdefg]
  newapi-release verify-backup DIRECTORY

The update command resolves latest to an immutable SHA image, backs up MySQL,
tests migrations against a temporary schema, deploys, and rolls back on failure.
The rollback command restores only the previous application image; it never
restores MySQL automatically.
The restart command starts a stopped container or restarts the existing running
container, keeps its image/configuration, and verifies application health.
The verify-backup command checks a sealed recovery package offline; it does not
require root or Docker and does not perform a database restore.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

check_prerequisites() {
  local required_command
  [ "$(id -u)" -eq 0 ] || die "run as root"
  [ -d "$APP_DIR" ] || die "app directory not found: $APP_DIR"
  [ -f "$COMPOSE_FILE" ] || die "compose file not found: $COMPOSE_FILE"
  for required_command in docker flock curl gzip sha256sum awk sed grep mktemp stat python3 timeout; do
    require_command "$required_command"
  done
  docker compose version >/dev/null
  docker inspect "$CONTAINER_NAME" >/dev/null
  docker inspect "$MYSQL_CONTAINER" >/dev/null
  [[ "$HEALTH_TIMEOUT" =~ ^[0-9]+$ ]] && [ "$HEALTH_TIMEOUT" -gt 0 ] \
    || die "NEWAPI_HEALTH_TIMEOUT must be a positive integer"
  [[ "$PREFLIGHT_PASSES" =~ ^[0-9]+$ ]] && [ "$PREFLIGHT_PASSES" -ge 2 ] \
    || die "NEWAPI_PREFLIGHT_PASSES must be at least 2"
}

check_restart_prerequisites() {
  local required_command
  [ "$(id -u)" -eq 0 ] || die "run as root"
  for required_command in docker flock curl timeout python3; do
    require_command "$required_command"
  done
  [[ "$HEALTH_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "NEWAPI_HEALTH_TIMEOUT must be a positive integer"
  [[ "$RESTART_STOP_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || die "NEWAPI_RESTART_STOP_TIMEOUT must be a positive integer"
  timeout --kill-after=5 10 docker info --format '{{.ServerVersion}}' >/dev/null \
    || die "Docker daemon is unavailable; check systemctl status docker"
}

acquire_lock() {
  install -d -m 700 "$(dirname "$LOCK_FILE")"
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "another new-api deployment or maintenance operation holds $LOCK_FILE; inspect it before retrying (do not delete the lock file)"
}

require_no_snapshot_ddl_guard() {
  # The PITR snapshot acquires its MySQL backup lock under our release flock,
  # then releases the flock before streaming. Refuse promptly instead of
  # allowing migration DDL to wait behind a slow remote upload.
  local active
  active="$(timeout --kill-after=2 10 docker exec "$MYSQL_CONTAINER" sh -c \
    'MYSQL_PWD="${MYSQL_ROOT_PASSWORD:?}" exec mysql --user=root --protocol=SOCKET --batch --skip-column-names --execute="SELECT COUNT(*) FROM performance_schema.metadata_locks WHERE OBJECT_TYPE=\"BACKUP LOCK\" AND LOCK_STATUS=\"GRANTED\""' 2>/dev/null)" \
    || die "cannot verify MySQL snapshot lock; no deployment started"
  [[ "$active" =~ ^[0-9]+$ ]] || die "unrecognized MySQL snapshot lock status; no deployment started"
  [ "$active" -eq 0 ] || die "a consistent PITR snapshot protects MySQL DDL; retry after the snapshot finishes (do not kill the backup or remove locks)"
}

require_online_update_source() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" = "true" ] \
    && curl -fsS --connect-timeout 2 --max-time 5 "$HEALTH_URL" >/dev/null 2>&1 \
    || die "source service is offline; run newapi-restart or use newapi-rollback before updating (do not stop it before backup/preflight)"
}

wait_for_restart_health() {
  local expected_container="$1" expected_image="$2"
  local deadline=$((SECONDS + HEALTH_TIMEOUT)) next_report=0 stable=0 previous_start=""
  local snapshot container_id running_id state started_at remaining request_timeout
  while [ "$SECONDS" -lt "$deadline" ]; do
    remaining=$((deadline - SECONDS))
    [ "$remaining" -gt 0 ] || break
    request_timeout=$((remaining < 5 ? remaining : 5))
    snapshot="$(timeout --kill-after=1 "$request_timeout" docker inspect -f \
      '{{.Id}} {{.Image}} {{.State.Status}} {{.State.StartedAt}}' "$expected_container" 2>/dev/null)" || return 1
    read -r container_id running_id state started_at <<<"$snapshot"
    [ "$container_id" = "$expected_container" ] && [ "$running_id" = "$expected_image" ] || return 1
    case "$state" in
      running|restarting) ;;
      *) return 1 ;;
    esac
    if [ "$started_at" != "$previous_start" ]; then stable=0; previous_start="$started_at"; fi
    remaining=$((deadline - SECONDS))
    [ "$remaining" -gt 0 ] || break
    request_timeout=$((remaining < 5 ? remaining : 5))
    if [ "$state" = running ] && curl -fsS --connect-timeout "$request_timeout" --max-time "$request_timeout" "$HEALTH_URL" 2>/dev/null \
      | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("success") is True else 1)' 2>/dev/null; then
      stable=$((stable + 1))
      [ "$stable" -ge 2 ] && return 0
    else
      stable=0
    fi
    if [ "$SECONDS" -ge "$next_report" ]; then
      log "等待应用恢复：container=${state}，剩余最多 ${remaining}s"
      next_report=$((SECONDS + 5))
    fi
    sleep 1
  done
  return 1
}

command_restart() {
  local snapshot container_id running_id state operation operation_timeout
  parse_dry_run "$@"
  [ "${#POSITIONAL_ARGS[@]}" -eq 0 ] || die "restart accepts only --dry-run"
  acquire_lock
  snapshot="$(timeout --kill-after=5 10 docker inspect -f '{{.Id}} {{.Image}} {{.State.Status}}' "$CONTAINER_NAME")" \
    || die "cannot inspect $CONTAINER_NAME; restart requires an existing container (no image will be pulled or recreated)"
  read -r container_id running_id state <<<"$snapshot"
  [ -n "$container_id" ] && [ -n "$running_id" ] || die "invalid container inspection result"
  case "$state" in
    exited|created) operation=start ;;
    running|restarting) operation=restart ;;
    *) die "unsupported container state: $state; inspect the container before retrying" ;;
  esac
  log "恢复当前容器：${CONTAINER_NAME}，状态=${state}，操作=${operation}，镜像=${running_id}"
  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run：仅预览，不启动或重启容器"
    return 0
  fi
  # Startup can execute automatic schema migrations even for the current image.
  # Check before stopping a running container, not after its replacement starts.
  require_no_snapshot_ddl_guard
  operation_timeout=$((RESTART_STOP_TIMEOUT + 15))
  if { [ "$operation" = start ] && timeout --kill-after=5 "$operation_timeout" docker start "$container_id" >/dev/null; } \
    || { [ "$operation" = restart ] && timeout --kill-after=5 "$operation_timeout" docker restart --timeout "$RESTART_STOP_TIMEOUT" "$container_id" >/dev/null; }; then
    log "Docker 已接受 ${operation}，正在检查应用健康（最多 ${HEALTH_TIMEOUT}s）"
    if wait_for_restart_health "$container_id" "$running_id"; then
      append_history "$operation" "$running_id" "$running_id" success "" || log "WARNING: cannot write restart history" >&2
      log "恢复成功：${CONTAINER_NAME}，状态接口连续两次通过，容器和镜像保持不变"
      return 0
    fi
  fi
  append_history "$operation" "$running_id" "$running_id" failed "" || log "WARNING: cannot write restart history" >&2
  die "恢复未通过或操作超时；检查 docker inspect ${CONTAINER_NAME} 和 docker logs --since 5m --tail 100 ${CONTAINER_NAME}；必要时 newapi-rollback。超时后 Docker 操作可能仍在完成，请先检查状态"
}

image_id() {
  docker image inspect -f '{{.Id}}' "$1"
}

image_version() {
  docker run --rm --entrypoint /new-api "$1" --version 2>/dev/null | tr -d '\r' | tail -n 1
}

normalize_explicit_target() {
  local requested="$1"
  if [[ "$requested" =~ ^sha-[0-9a-f]{7,40}$ ]]; then
    printf '%s:%s\n' "$IMAGE_REPOSITORY" "$requested"
  elif [[ "$requested" =~ ^[0-9a-f]{7,40}$ ]]; then
    printf '%s:sha-%s\n' "$IMAGE_REPOSITORY" "$requested"
  elif [[ "$requested" =~ ^${IMAGE_REPOSITORY//./\.}@sha256:[0-9a-f]{64}$ ]]; then
    printf '%s\n' "$requested"
  elif [[ "$requested" =~ ^${IMAGE_REPOSITORY//./\.}:sha-[0-9a-f]{7,40}$ ]]; then
    printf '%s\n' "$requested"
  else
    return 1
  fi
}

github_main_sha() {
  curl -fsSL --max-time 20 "https://api.github.com/repos/$GITHUB_REPOSITORY/commits/main" \
    | sed -nE 's/^[[:space:]]*"sha": "([0-9a-f]{40})",?$/\1/p' \
    | {
      local first_sha
      IFS= read -r first_sha || return 1
      printf '%s\n' "$first_sha"
      cat >/dev/null
    }
}

resolve_target() {
  local requested="${1:-latest}"
  local resolved latest_ref latest_id version commit_sha candidate candidate_id digest_ref

  if [ "$requested" = "latest" ]; then
    latest_ref="$IMAGE_REPOSITORY:latest"
    log "pulling discovery image: $latest_ref"
    docker pull "$latest_ref"
    latest_id="$(image_id "$latest_ref")"
    version="$(image_version "$latest_ref")"
    commit_sha="$(github_main_sha)"
    [ -n "$commit_sha" ] || die "cannot resolve GitHub main commit"

    if [[ "$version" =~ ^main-([0-9a-f]{7,40})$ ]]; then
      [ "${commit_sha:0:7}" = "${BASH_REMATCH[1]:0:7}" ] \
        || die "latest image ($version) does not match GitHub main (${commit_sha:0:7}); wait for the build"
      candidate="$IMAGE_REPOSITORY:sha-${BASH_REMATCH[1]:0:7}"
      docker pull "$candidate"
      candidate_id="$(image_id "$candidate")"
      [ "$candidate_id" = "$latest_id" ] || die "latest and immutable SHA image IDs differ"
      resolved="$candidate"
    else
      digest_ref="$(docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$latest_ref" \
        | awk -v prefix="$IMAGE_REPOSITORY@" 'index($0, prefix) == 1 {print; exit}')"
      [ -n "$digest_ref" ] || die "cannot resolve immutable digest for latest"
      resolved="$digest_ref"
    fi
  else
    resolved="$(normalize_explicit_target "$requested")" \
      || die "unsupported target: $requested"
    log "pulling target image: $resolved"
    docker pull "$resolved"
    version="$(image_version "$resolved")"
  fi

  TARGET_IMAGE="$resolved"
  TARGET_ID="$(image_id "$resolved")"
  TARGET_VERSION="${version:-unknown}"
}

actual_image() {
  docker inspect -f '{{.Config.Image}}' "$CONTAINER_NAME"
}

actual_image_id() {
  docker inspect -f '{{.Image}}' "$CONTAINER_NAME"
}

actual_version() {
  image_version "$(actual_image)"
}

schema_fingerprint() {
  local database_name="$1"
  docker exec -e TARGET_DB="$database_name" "$MYSQL_CONTAINER" sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -Nse "
    SELECT CONCAT('\''C|'\'', TABLE_NAME, '\''|'\'', COLUMN_NAME, '\''|'\'', COLUMN_TYPE, '\''|'\'', IS_NULLABLE, '\''|'\'', COALESCE(COLUMN_DEFAULT, '\''<NULL>'\''), '\''|'\'', EXTRA)
    FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = '\''$TARGET_DB'\'' ORDER BY TABLE_NAME, ORDINAL_POSITION;
    SELECT CONCAT('\''I|'\'', TABLE_NAME, '\''|'\'', INDEX_NAME, '\''|'\'', NON_UNIQUE, '\''|'\'', GROUP_CONCAT(COLUMN_NAME ORDER BY SEQ_IN_INDEX))
    FROM information_schema.STATISTICS WHERE TABLE_SCHEMA = '\''$TARGET_DB'\'' GROUP BY TABLE_NAME, INDEX_NAME, NON_UNIQUE ORDER BY TABLE_NAME, INDEX_NAME;
  "' 2>/dev/null | sha256sum | awk '{print $1}'
}

cleanup_preflight() {
  set +e
  [ -n "$PREFLIGHT_CONTAINER" ] && docker rm -f "$PREFLIGHT_CONTAINER" >/dev/null 2>&1
  if [ -n "$PREFLIGHT_DB" ] && [ -n "$PREFLIGHT_USER" ]; then
    docker exec -e TARGET_DB="$PREFLIGHT_DB" -e TARGET_USER="$PREFLIGHT_USER" "$MYSQL_CONTAINER" sh -c \
      'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "DROP DATABASE IF EXISTS \`$TARGET_DB\`; DROP USER IF EXISTS '\''$TARGET_USER'\''@'\''%'\'';"' \
      >/dev/null 2>&1
  fi
  if [[ -n "$PREFLIGHT_WORK_DIR" && "$PREFLIGHT_WORK_DIR" == /tmp/newapi-preflight-* ]]; then
    rm -rf -- "$PREFLIGHT_WORK_DIR"
  fi
  PREFLIGHT_DB=""
  PREFLIGHT_USER=""
  PREFLIGHT_CONTAINER=""
  PREFLIGHT_WORK_DIR=""
  set -e
}

wait_for_container_health() {
  local expected_id="$1"
  local _attempt state running_id restarts
  for _attempt in $(seq 1 "$HEALTH_TIMEOUT"); do
    state="$(docker inspect -f '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)"
    running_id="$(docker inspect -f '{{.Image}}' "$CONTAINER_NAME" 2>/dev/null || true)"
    restarts="$(docker inspect -f '{{.RestartCount}}' "$CONTAINER_NAME" 2>/dev/null || echo 999)"
    if docker logs "$CONTAINER_NAME" 2>&1 | grep -Eqi 'Error 1091|DROP FOREIGN KEY|\[FATAL\]|panic detected'; then
      return 1
    fi
    if [ "$state" = "running" ] && [ "$running_id" = "$expected_id" ] && [ "$restarts" = "0" ] \
      && curl -fsS --connect-timeout 2 --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

run_preflight_pass() {
  local pass="$1"
  local ready=0 _attempt

  docker run -d --name "$PREFLIGHT_CONTAINER" --network "$DOCKER_NETWORK" \
    -e GIN_MODE=release \
    -e SQL_DSN="${PREFLIGHT_USER}:${PREFLIGHT_PASSWORD}@tcp(${MYSQL_CONTAINER}:3306)/${PREFLIGHT_DB}?charset=utf8mb4&parseTime=true&loc=Local" \
    "$TARGET_IMAGE" >/dev/null

  for _attempt in $(seq 1 "$HEALTH_TIMEOUT"); do
    if [ "$(docker inspect -f '{{.State.Running}}' "$PREFLIGHT_CONTAINER" 2>/dev/null || true)" != "true" ]; then
      docker logs "$PREFLIGHT_CONTAINER" || true
      return 1
    fi
    if [ "$(docker inspect -f '{{.Image}}' "$PREFLIGHT_CONTAINER" 2>/dev/null || true)" != "$TARGET_ID" ]; then
      return 1
    fi
    if docker exec "$PREFLIGHT_CONTAINER" wget -T 5 -qO- http://127.0.0.1:3000/api/status >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 1
  done

  docker logs "$PREFLIGHT_CONTAINER" >"$PREFLIGHT_WORK_DIR/pass-${pass}.log" 2>&1
  [ "$ready" -eq 1 ] || return 1
  if grep -Eqi 'Error 1091|DROP FOREIGN KEY|\[FATAL\]|panic detected' "$PREFLIGHT_WORK_DIR/pass-${pass}.log"; then
    return 1
  fi
  docker stop -t 10 "$PREFLIGHT_CONTAINER" >/dev/null
  docker rm "$PREFLIGHT_CONTAINER" >/dev/null
  log "preflight pass $pass succeeded"
}

preflight_target() {
  local timestamp pass fingerprint previous_fingerprint=""
  timestamp="$(date +%Y%m%d%H%M%S)"
  PREFLIGHT_DB="newapi_preflight_${timestamp}_$$"
  PREFLIGHT_USER="pf${timestamp}$$"
  PREFLIGHT_PASSWORD="P${timestamp}${RANDOM}x"
  PREFLIGHT_CONTAINER="new-api-preflight-${timestamp}-$$"
  PREFLIGHT_WORK_DIR="/tmp/newapi-preflight-${timestamp}-$$"
  mkdir -p "$PREFLIGHT_WORK_DIR"

  docker exec -e TARGET_DB="$PREFLIGHT_DB" -e TARGET_USER="$PREFLIGHT_USER" -e TARGET_PASSWORD="$PREFLIGHT_PASSWORD" "$MYSQL_CONTAINER" sh -c \
    'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "CREATE DATABASE \`$TARGET_DB\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; CREATE USER '\''$TARGET_USER'\''@'\''%'\'' IDENTIFIED BY '\''$TARGET_PASSWORD'\''; GRANT ALL PRIVILEGES ON \`$TARGET_DB\`.* TO '\''$TARGET_USER'\''@'\''%'\'';"'

  docker exec "$MYSQL_CONTAINER" sh -c \
    'exec mysqldump -uroot -p"$MYSQL_ROOT_PASSWORD" --no-data --skip-triggers --single-transaction --no-tablespaces "$MYSQL_DATABASE"' \
    | docker exec -i -e TARGET_DB="$PREFLIGHT_DB" "$MYSQL_CONTAINER" sh -c \
      'exec mysql -uroot -p"$MYSQL_ROOT_PASSWORD" "$TARGET_DB"'

  for pass in $(seq 1 "$PREFLIGHT_PASSES"); do
    run_preflight_pass "$pass"
    fingerprint="$(schema_fingerprint "$PREFLIGHT_DB")"
    if [ -n "$previous_fingerprint" ] && [ "$fingerprint" != "$previous_fingerprint" ]; then
      die "migration is not idempotent: schema changed after preflight pass $pass"
    fi
    previous_fingerprint="$fingerprint"
  done
  log "preflight schema is stable: $previous_fingerprint"
  cleanup_preflight
}

available_kb() {
  df -Pk "$APP_DIR" | awk 'NR == 2 {print $4}'
}

safe_label() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

create_database_backup() {
  local current_version="$1"
  local target_version="$2"
  local timestamp label temporary_dump

  [ "$(available_kb)" -ge "$MIN_FREE_KB" ] || die "less than $((MIN_FREE_KB / 1024)) MiB free disk space"
  timestamp="$(date +%Y%m%d-%H%M%S)"
  label="$(safe_label "${current_version}-to-${target_version}")"
  ACTIVE_BACKUP_DIR="$BACKUP_ROOT/${timestamp}-${label}-$$"
  install -d -m 700 "$BACKUP_ROOT"
  mkdir -m 700 "$ACTIVE_BACKUP_DIR"
  cp -a "$COMPOSE_FILE" "$ACTIVE_BACKUP_DIR/docker-compose.yml"
  [ -f "$APP_DIR/.env" ] && cp -a "$APP_DIR/.env" "$ACTIVE_BACKUP_DIR/.env"
  [ -f "$STATE_FILE" ] && cp -a "$STATE_FILE" "$ACTIVE_BACKUP_DIR/state.env"

  temporary_dump="$ACTIVE_BACKUP_DIR/mysql.sql.gz.tmp"
  docker exec "$MYSQL_CONTAINER" sh -c \
    'exec mysqldump -uroot -p"$MYSQL_ROOT_PASSWORD" --single-transaction --quick --routines --triggers --events --hex-blob --no-tablespaces "$MYSQL_DATABASE"' \
    | gzip -1 >"$temporary_dump"
  mv "$temporary_dump" "$ACTIVE_BACKUP_DIR/mysql.sql.gz"
  gzip -t "$ACTIVE_BACKUP_DIR/mysql.sql.gz"
  (cd "$ACTIVE_BACKUP_DIR" && sha256sum mysql.sql.gz >DATABASE_SHA256SUMS)
  log "database dump completed (recovery package not yet sealed): $ACTIVE_BACKUP_DIR"
}

# A self-contained offline verifier keeps the installed entrypoint a single file.
backup_manifest() {
  python3 - "$@" <<'PY'
import hashlib
import os
from pathlib import PurePosixPath
import re
import stat
import sys
import uuid

mode, directory = sys.argv[1:]
# Normalize a trailing slash so O_NOFOLLOW still rejects a linked package root.
directory = os.path.abspath(directory)
manifest_name = "SHA256SUMS"
required = {"mysql.sql.gz", "DATABASE_SHA256SUMS", "docker-compose.yml",
            "release-state-after.env", "recovery-metadata.env", "deploy-success.log"}
root = None
staged = None
published = False


def identity(value):
    return (value.st_dev, value.st_ino, value.st_mode, value.st_nlink,
            value.st_size, value.st_mtime_ns, value.st_ctime_ns)


def safe_path(name):
    parts = PurePosixPath(name)
    if (not name or parts.is_absolute() or parts.as_posix() != name
            or any(part in (".", "..") for part in name.split("/"))
            or any(ord(char) < 32 or ord(char) == 127 or char in "\\\x85\u2028\u2029" for char in name)):
        raise ValueError("unsafe manifest path")


def read_file(parent, name, expected, collect=False):
    if not stat.S_ISREG(expected.st_mode) or expected.st_nlink != 1:
        raise ValueError("links and non-regular files are not allowed: " + name)
    descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
    digest = hashlib.sha256()
    data = bytearray()
    with os.fdopen(descriptor, "rb") as source:
        if identity(os.fstat(source.fileno())) != identity(expected):
            raise ValueError("file replaced before reading: " + name)
        while True:
            block = source.read(1024 * 1024)
            if not block:
                break
            digest.update(block)
            if collect:
                if len(data) + len(block) > 16 * 1024 * 1024:
                    raise ValueError("manifest exceeds 16 MiB")
                data.extend(block)
        if identity(os.fstat(source.fileno())) != identity(expected):
            raise ValueError("file changed while reading: " + name)
    return bytes(data) if collect else digest.hexdigest()


def scan(hashes=False):
    entries, checksums = {}, {}

    def visit(parent, prefix=""):
        for name in sorted(os.listdir(parent)):
            relative = prefix + name
            safe_path(relative)
            info = os.stat(name, dir_fd=parent, follow_symlinks=False)
            if not prefix and name in (manifest_name, staged):
                if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                    raise ValueError("invalid manifest file")
                continue
            entries[relative] = identity(info)
            if stat.S_ISDIR(info.st_mode):
                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
                try:
                    if identity(os.fstat(child)) != identity(info):
                        raise ValueError("directory replaced: " + relative)
                    visit(child, relative + "/")
                finally:
                    os.close(child)
            elif stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
                checksums[relative] = read_file(parent, name, info) if hashes else None
            else:
                raise ValueError("links and special files are not allowed: " + relative)

    visit(root)
    # Opening child directories through anchored descriptors prevents link traversal.
    # Also reject replacement of the root path itself while the tree was inspected.
    current = os.stat(directory, follow_symlinks=False)
    if (current.st_dev, current.st_ino) != (os.fstat(root).st_dev, os.fstat(root).st_ino):
        raise ValueError("backup directory replaced")
    return entries, checksums


def parse_manifest(name):
    info = os.stat(name, dir_fd=root, follow_symlinks=False)
    data = read_file(root, name, info, collect=True).decode("utf-8")
    values = {}
    for line in data.splitlines():
        if not re.fullmatch(r"[0-9a-f]{64}  .+", line):
            raise ValueError("invalid SHA-256 manifest line")
        checksum, relative = line[:64], line[66:]
        safe_path(relative)
        if relative == manifest_name or relative in values:
            raise ValueError("duplicate or self-referencing manifest entry")
        values[relative] = checksum
    if not required.issubset(values):
        raise ValueError("recovery package is missing required files")
    return values, identity(info)


def verify(name):
    expected, before_manifest = parse_manifest(name)
    before, actual = scan(hashes=True)
    after, _ = scan()
    if before != after or identity(os.stat(name, dir_fd=root, follow_symlinks=False)) != before_manifest:
        raise ValueError("recovery package changed during verification")
    if expected.keys() != actual.keys():
        raise ValueError("manifest file set does not match recovery package")
    if expected != actual:
        raise ValueError("recovery package checksum mismatch")
    return before


try:
    if mode not in ("seal", "verify"):
        raise ValueError("unsupported manifest operation")
    root = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    if mode == "seal":
        if manifest_name in os.listdir(root):
            raise ValueError("recovery package is already sealed; refusing to replace its manifest")
        before, checksums = scan(hashes=True)
        if not required.issubset(checksums):
            raise ValueError("recovery package is missing required files")
        staged = ".SHA256SUMS-" + uuid.uuid4().hex + ".tmp"
        descriptor = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=root)
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as output:
            for relative, checksum in sorted(checksums.items()):
                output.write(checksum + "  " + relative + "\n")
            output.flush()
            os.fsync(output.fileno())
        if verify(staged) != before:
            raise ValueError("recovery package changed during sealing")
        # Publish the completion marker only after the complete second read passes.
        os.rename(staged, manifest_name, src_dir_fd=root, dst_dir_fd=root)
        staged = None
        published = True
        os.fsync(root)
    else:
        verify(manifest_name)
    print("recovery package " + ("sealed" if mode == "seal" else "verified") + ": " + directory)
except (OSError, ValueError, UnicodeError) as error:
    if published:
        os.unlink(manifest_name, dir_fd=root)
    print("ERROR: recovery package " + mode + " failed: " + str(error), file=sys.stderr)
    sys.exit(1)
finally:
    if staged is not None:
        try:
            os.unlink(staged, dir_fd=root)
        except FileNotFoundError:
            pass
    if root is not None:
        os.close(root)
PY
}

finalize_recovery_backup() {
  local source_version="$1"
  cp -a "$STATE_FILE" "$ACTIVE_BACKUP_DIR/release-state-after.env" || return
  {
    printf 'FORMAT_VERSION=1\n'
    printf 'DB_BACKUP_FORMAT=mysqldump-single-transaction\n'
    printf 'DB_BACKUP_SCOPE=configured-MYSQL_DATABASE-with-routines-triggers-events\n'
    printf 'PITR_VERIFIED=0\n'
    printf 'SOURCE_IMAGE=%q\n' "$RECOVERY_IMAGE"
    printf 'SOURCE_ID=%q\n' "$RECOVERY_ID"
    printf 'SOURCE_VERSION=%q\n' "$source_version"
    printf 'TARGET_IMAGE=%q\n' "$TARGET_IMAGE"
    printf 'TARGET_ID=%q\n' "$TARGET_ID"
    printf 'TARGET_VERSION=%q\n' "$TARGET_VERSION"
    printf 'SEALED_AT=%q\n' "$(timestamp_iso)"
  } >"$ACTIVE_BACKUP_DIR/recovery-metadata.env" || return
  docker logs "$CONTAINER_NAME" >"$ACTIVE_BACKUP_DIR/deploy-success.log" 2>&1 || return
  backup_manifest seal "$ACTIVE_BACKUP_DIR"
}

replace_compose_image() {
  local target="$1"
  local temporary_file file_mode
  temporary_file="$(mktemp "$APP_DIR/.docker-compose.yml.XXXXXX")"
  file_mode="$(stat -c '%a' "$COMPOSE_FILE" 2>/dev/null || stat -f '%Lp' "$COMPOSE_FILE")"
  chmod "$file_mode" "$temporary_file"

  awk -v service="$SERVICE_NAME" -v target="$target" '
    BEGIN { in_service = 0; replaced = 0 }
    $0 == "  " service ":" { in_service = 1; print; next }
    in_service && $0 ~ /^  [^[:space:]][^:]*:[[:space:]]*$/ { in_service = 0 }
    in_service && $0 ~ /^[[:space:]]+image:[[:space:]]*/ {
      match($0, /^[[:space:]]*/)
      print substr($0, 1, RLENGTH) "image: " target
      replaced++
      next
    }
    { print }
    END { if (replaced != 1) exit 42 }
  ' "$COMPOSE_FILE" >"$temporary_file" || {
    rm -f "$temporary_file"
    die "could not replace image for service $SERVICE_NAME"
  }

  docker compose -f "$temporary_file" config >/dev/null
  mv "$temporary_file" "$COMPOSE_FILE"
  [ "$(compose_service_image)" = "$target" ] || die "compose did not resolve target image"
}

compose_service_image() {
  docker compose -f "$COMPOSE_FILE" config | awk -v service="$SERVICE_NAME" '
    $0 == "  " service ":" { in_service = 1; next }
    in_service && $0 ~ /^  [^[:space:]][^:]*:[[:space:]]*$/ { exit 42 }
    in_service && $0 ~ /^    image:[[:space:]]*/ {
      sub(/^    image:[[:space:]]*/, "")
      print
      found = 1
      exit
    }
    END { if (!found) exit 42 }
  '
}

write_state() {
  local current_image="$1" current_id="$2" current_version="$3"
  local previous_image="$4" previous_id="$5" previous_version="$6" backup_dir="$7"
  local temporary_file
  install -d -m 700 "$STATE_DIR"
  temporary_file="$(mktemp "$STATE_DIR/.state.XXXXXX")"
  {
    printf 'CURRENT_IMAGE=%q\n' "$current_image"
    printf 'CURRENT_ID=%q\n' "$current_id"
    printf 'CURRENT_VERSION=%q\n' "$current_version"
    printf 'PREVIOUS_IMAGE=%q\n' "$previous_image"
    printf 'PREVIOUS_ID=%q\n' "$previous_id"
    printf 'PREVIOUS_VERSION=%q\n' "$previous_version"
    printf 'LAST_BACKUP_DIR=%q\n' "$backup_dir"
    printf 'UPDATED_AT=%q\n' "$(timestamp_iso)"
  } >"$temporary_file"
  mv "$temporary_file" "$STATE_FILE"
}

append_history() {
  local action="$1" from_image="$2" to_image="$3" result="$4" backup_dir="$5"
  install -d -m 700 "$STATE_DIR"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(timestamp_iso)" "$action" "$from_image" "$to_image" "$result" "$backup_dir" \
    >>"$HISTORY_FILE"
}

load_state() {
  [ -f "$STATE_FILE" ] || die "release state is not initialized; run: newapi-release init [previous-sha]"
  # shellcheck disable=SC1090
  source "$STATE_FILE"
}

recover_previous_deployment() {
  set +e
  [ "$RECOVERY_REQUIRED" -eq 1 ] || return 0
  log "deployment failed; restoring $RECOVERY_IMAGE"
  docker logs "$CONTAINER_NAME" >"${ACTIVE_BACKUP_DIR:-$STATE_DIR}/failed-deployment.log" 2>&1 || true
  cp -a "$RECOVERY_COMPOSE" "$COMPOSE_FILE"
  if [ "$RECOVERY_STATE_EXISTED" -eq 1 ]; then
    install -d -m 700 "$STATE_DIR"
    cp -a "$RECOVERY_STATE_SNAPSHOT" "$STATE_FILE"
  else
    rm -f "$STATE_FILE"
  fi
  cd "$APP_DIR"
  docker compose -f "$COMPOSE_FILE" config >/dev/null
  docker compose -f "$COMPOSE_FILE" up -d --no-deps --force-recreate "$SERVICE_NAME"
  if wait_for_container_health "$RECOVERY_ID"; then
    log "automatic recovery succeeded"
  else
    log "CRITICAL: automatic recovery failed" >&2
  fi
  RECOVERY_REQUIRED=0
}

on_exit() {
  local exit_code="$?"
  trap - EXIT
  # Let recovery finish even if the terminal disconnects again.
  trap '' HUP INT TERM
  set +e
  cleanup_preflight
  if [ "$exit_code" -ne 0 ]; then
    recover_previous_deployment
  fi
  exit "$exit_code"
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

deploy_target() {
  local recovery_compose="$1" recovery_dir
  RECOVERY_COMPOSE="$recovery_compose"
  RECOVERY_IMAGE="$(actual_image)"
  RECOVERY_ID="$(actual_image_id)"
  recovery_dir="$(dirname "$recovery_compose")"
  RECOVERY_STATE_SNAPSHOT="$recovery_dir/release-state-before.env"
  if [ -f "$STATE_FILE" ]; then
    cp -a "$STATE_FILE" "$RECOVERY_STATE_SNAPSHOT"
    RECOVERY_STATE_EXISTED=1
  else
    RECOVERY_STATE_EXISTED=0
  fi
  RECOVERY_REQUIRED=1

  replace_compose_image "$TARGET_IMAGE"
  cd "$APP_DIR"
  docker compose -f "$COMPOSE_FILE" up -d --no-deps --force-recreate "$SERVICE_NAME"
  wait_for_container_health "$TARGET_ID" || die "new image failed health checks"
}

parse_dry_run() {
  DRY_RUN=0
  POSITIONAL_ARGS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      *) POSITIONAL_ARGS+=("$1") ;;
    esac
    shift
  done
}

reconcile_current_target() {
  local actual_image="$1" actual_version="$2"
  local declared_image state_matches=0 unmanaged_update=0
  local previous_image="" previous_id="" previous_version="" last_backup=""
  local reconcile_dir state_snapshot=""

  declared_image="$(compose_service_image)" || die "cannot resolve compose image for $SERVICE_NAME"
  if [ -f "$STATE_FILE" ]; then
    load_state
    if [ "${CURRENT_ID:-}" = "$TARGET_ID" ]; then
      previous_image="${PREVIOUS_IMAGE:-}"
      previous_id="${PREVIOUS_ID:-}"
      previous_version="${PREVIOUS_VERSION:-}"
      last_backup="${LAST_BACKUP_DIR:-}"
      if [ "${CURRENT_IMAGE:-}" = "$TARGET_IMAGE" ]; then
        state_matches=1
      fi
    elif [ -n "${CURRENT_IMAGE:-}" ] && [ -n "${CURRENT_ID:-}" ]; then
      previous_image="$CURRENT_IMAGE"
      previous_id="$CURRENT_ID"
      previous_version="${CURRENT_VERSION:-unknown}"
      unmanaged_update=1
    else
      unmanaged_update=1
    fi
  else
    unmanaged_update=1
  fi

  if [ "$state_matches" -eq 1 ] && [ "$declared_image" = "$TARGET_IMAGE" ]; then
    log "already running the requested image"
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry run detected release metadata drift; no changes made"
    return 0
  fi

  reconcile_dir="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-reconcile-$(safe_label "$actual_version")"
  install -d -m 700 "$reconcile_dir"
  cp -a "$COMPOSE_FILE" "$reconcile_dir/docker-compose-before.yml"
  if [ -f "$STATE_FILE" ]; then
    state_snapshot="$reconcile_dir/state-before.env"
    cp -a "$STATE_FILE" "$state_snapshot"
  fi

  if ! (
    replace_compose_image "$TARGET_IMAGE"
    write_state "$TARGET_IMAGE" "$TARGET_ID" "$TARGET_VERSION" \
      "$previous_image" "$previous_id" "$previous_version" "$last_backup"
  ); then
    cp -a "$reconcile_dir/docker-compose-before.yml" "$COMPOSE_FILE" \
      || log "CRITICAL: could not restore compose after reconciliation failure"
    if [ -n "$state_snapshot" ]; then
      cp -a "$state_snapshot" "$STATE_FILE" \
        || log "CRITICAL: could not restore release state after reconciliation failure"
    else
      rm -f "$STATE_FILE"
    fi
    die "could not reconcile release metadata"
  fi

  append_history reconcile "$actual_image" "$TARGET_IMAGE" success "$reconcile_dir" \
    || log "WARNING: could not append reconciliation history"
  log "running image was already current; compose and release state were reconciled"
  if [ "$unmanaged_update" -eq 1 ]; then
    log "WARNING: unmanaged update detected; no pre-update MySQL backup is available"
  fi
}

command_update() {
  local current_image current_id current_version requested
  local state_previous_image state_previous_id state_previous_version
  parse_dry_run "$@"
  [ "${#POSITIONAL_ARGS[@]}" -le 1 ] || die "too many arguments"
  requested="${POSITIONAL_ARGS[0]:-latest}"
  acquire_lock
  require_online_update_source
  require_no_snapshot_ddl_guard
  resolve_target "$requested"

  current_image="$(actual_image)"
  current_id="$(actual_image_id)"
  current_version="$(actual_version)"
  log "current: $current_image ($current_version)"
  log "target:  $TARGET_IMAGE ($TARGET_VERSION)"

  if [ "$current_id" = "$TARGET_ID" ]; then
    reconcile_current_target "$current_image" "$current_version"
    return 0
  fi
  [ "$DRY_RUN" -eq 0 ] || {
    log "dry run completed; no changes made"
    return 0
  }

  create_database_backup "$current_version" "$TARGET_VERSION"
  preflight_target
  deploy_target "$ACTIVE_BACKUP_DIR/docker-compose.yml"
  state_previous_image="$current_image"
  state_previous_id="$current_id"
  state_previous_version="$current_version"
  if [ "$current_id" = "$TARGET_ID" ]; then
    state_previous_image=""
    state_previous_id=""
    state_previous_version=""
  fi
  write_state "$TARGET_IMAGE" "$TARGET_ID" "$TARGET_VERSION" \
    "$state_previous_image" "$state_previous_id" "$state_previous_version" "$ACTIVE_BACKUP_DIR"
  RECOVERY_REQUIRED=0
  append_history update "$current_image" "$TARGET_IMAGE" success "$ACTIVE_BACKUP_DIR" \
    || log "WARNING: could not append update history"
  if ! finalize_recovery_backup "$current_version"; then
    append_history backup-seal "$current_image" "$TARGET_IMAGE" failed "$ACTIVE_BACKUP_DIR" \
      || log "WARNING: could not append backup sealing failure"
    die "application update is healthy, but recovery package sealing failed: $ACTIVE_BACKUP_DIR; MySQL dump retained, no complete SHA256SUMS marker; application was not rolled back"
  fi
  log "update succeeded: $TARGET_IMAGE"
}

command_rollback() {
  local current_image current_id current_version rollback_dir
  parse_dry_run "$@"
  [ "${#POSITIONAL_ARGS[@]}" -eq 0 ] || die "rollback does not accept an image argument"
  acquire_lock
  require_no_snapshot_ddl_guard
  load_state
  [ -n "${PREVIOUS_IMAGE:-}" ] || die "no previous image is available"

  current_image="$(actual_image)"
  current_id="$(actual_image_id)"
  current_version="$(actual_version)"
  [ "$current_id" = "$CURRENT_ID" ] \
    || die "running image differs from release state; run newapi-release init before rollback"

  log "current:  $current_image ($current_version)"
  log "rollback: $PREVIOUS_IMAGE (${PREVIOUS_VERSION:-unknown})"
  [ "$DRY_RUN" -eq 0 ] || {
    log "dry run completed; no changes made"
    return 0
  }

  docker pull "$PREVIOUS_IMAGE"
  TARGET_IMAGE="$PREVIOUS_IMAGE"
  TARGET_ID="$(image_id "$PREVIOUS_IMAGE")"
  TARGET_VERSION="$(image_version "$PREVIOUS_IMAGE")"
  [ "$TARGET_ID" = "$PREVIOUS_ID" ] || die "previous image ID no longer matches release state"

  rollback_dir="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-rollback-$(safe_label "$current_version")"
  install -d -m 700 "$rollback_dir"
  cp -a "$COMPOSE_FILE" "$rollback_dir/docker-compose.yml"
  ACTIVE_BACKUP_DIR="$rollback_dir"
  deploy_target "$rollback_dir/docker-compose.yml"
  write_state "$TARGET_IMAGE" "$TARGET_ID" "$TARGET_VERSION" "" "" "" "${LAST_BACKUP_DIR:-}"
  RECOVERY_REQUIRED=0
  append_history rollback "$current_image" "$TARGET_IMAGE" success "$rollback_dir" \
    || log "WARNING: could not append rollback history"
  docker logs "$CONTAINER_NAME" >"$rollback_dir/rollback-success.log" 2>&1 \
    || log "WARNING: could not save rollback log"
  log "rollback succeeded: $TARGET_IMAGE"
  log "MySQL was not restored automatically"
}

command_init() {
  local current_image current_id current_version previous_image="" previous_id="" previous_version=""
  [ "$#" -le 1 ] || die "init accepts at most one previous image"
  acquire_lock
  current_image="$(actual_image)"
  current_id="$(actual_image_id)"
  current_version="$(actual_version)"
  if [ "$#" -eq 1 ]; then
    resolve_target "$1"
    [ "$TARGET_ID" != "$current_id" ] || die "previous image must differ from current image"
    previous_image="$TARGET_IMAGE"
    previous_id="$TARGET_ID"
    previous_version="$TARGET_VERSION"
  fi
  write_state "$current_image" "$current_id" "$current_version" \
    "$previous_image" "$previous_id" "$previous_version" ""
  append_history init "" "$current_image" success ""
  log "release state initialized"
}

command_status() {
  local current_image current_id current_version declared_image
  current_image="$(actual_image)"
  current_id="$(actual_image_id)"
  current_version="$(actual_version)"
  declared_image="$(compose_service_image 2>/dev/null || printf unknown)"
  printf 'running_image=%s\n' "$current_image"
  printf 'running_id=%s\n' "$current_id"
  printf 'running_version=%s\n' "$current_version"
  printf 'compose_image=%s\n' "$declared_image"
  printf 'container_state=%s\n' "$(docker inspect -f '{{.State.Status}}' "$CONTAINER_NAME")"
  printf 'container_restarts=%s\n' "$(docker inspect -f '{{.RestartCount}}' "$CONTAINER_NAME")"
  if [ -f "$STATE_FILE" ]; then
    load_state
    printf 'state_current=%s\n' "$CURRENT_IMAGE"
    printf 'state_current_version=%s\n' "$CURRENT_VERSION"
    printf 'state_previous=%s\n' "${PREVIOUS_IMAGE:-}"
    printf 'last_backup=%s\n' "${LAST_BACKUP_DIR:-}"
    if [ "$current_id" = "$CURRENT_ID" ] && [ "$declared_image" = "$CURRENT_IMAGE" ]; then
      printf 'release_state=synchronized\n'
    else
      printf 'release_state=drifted\n'
    fi
  else
    printf 'release_state=not_initialized\n'
  fi
}

main() {
  local invoked command_name
  invoked="$(basename "$0")"

  case "$invoked" in
    newapi-update) command_name="update" ;;
    newapi-rollback) command_name="rollback" ;;
    newapi-restart) command_name="restart" ;;
    *) command_name="${1:-}"; [ "$#" -gt 0 ] && shift ;;
  esac

  case "$command_name" in
    help|-h|--help|"") usage; return 0 ;;
  esac

  if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then usage; return 0; fi
  if [ "$command_name" = verify-backup ]; then
    [ "$#" -eq 1 ] || die "verify-backup requires exactly one directory"
    require_command python3
    backup_manifest verify "$1"
    return
  fi
  if [ "$command_name" = restart ]; then
    check_restart_prerequisites
  else
    check_prerequisites
    cd "$APP_DIR"
  fi

  case "$command_name" in
    update) command_update "$@" ;;
    rollback) command_rollback "$@" ;;
    restart) command_restart "$@" ;;
    init) command_init "$@" ;;
    status) command_status ;;
    *) usage >&2; die "unknown command: $command_name" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
