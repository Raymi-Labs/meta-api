[mysqld]
# Unique target identity. Never copy the source auto.cnf or persisted settings.
server-id=14713539
log-bin=/var/lib/mysql/binlog
relay-log=/var/lib/mysql/relay-bin
skip-replica-start=ON
gtid-mode=OFF
enforce-gtid-consistency=OFF
binlog-format=ROW
binlog-row-image=FULL
binlog-checksum=CRC32
binlog-transaction-compression=OFF
binlog-encryption=OFF
binlog-expire-logs-seconds=604800
sync-binlog=1
innodb-flush-log-at-trx-commit=1
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
transaction-isolation=REPEATABLE-READ
sql-mode=ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
max-connections=151
max-allowed-packet=64M
# Initial budget on the 64 GiB target; re-evaluate with migrated workload.
innodb-buffer-pool-size=16G
event-scheduler=OFF
mysqlx=OFF
performance-schema=ON
performance-schema-session-connect-attrs-size=512
performance-schema-consumer-events-statements-current=ON
performance-schema-consumer-events-statements-history=ON
performance-schema-consumer-events-transactions-current=ON
performance-schema-instrument='wait/lock/metadata/sql/mdl=ON'
performance-schema-instrument='statement/sql/unlock_tables=ON'
performance-schema-instrument='transaction=ON'
