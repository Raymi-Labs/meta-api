# Host SSH protection only. Deploy to /etc/fail2ban/jail.d/.
[sshd]
enabled = true
backend = systemd
filter = sshd[mode=aggressive]
port = 22
protocol = tcp
banaction = nftables-multiport
findtime = 10m
maxretry = 6
bantime = 1h
bantime.increment = true
bantime.maxtime = 1d
ignoreip = 127.0.0.1/8 ::1
ignoreself = true
