{
  "name": "react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@douyinfe/semi-icons": "^2.63.1",
    "@douyinfe/semi-ui": "^2.69.1",
    "@lobehub/icons": "^2.0.0",
    "@visactor/react-vchart": "~1.8.8",
    "@visactor/vchart": "~1.8.8",
    "@visactor/vchart-semi-theme": "~1.8.8",
    "axios": "1.13.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.11",
    "dompurify": "3.4.11",
    "history": "^5.3.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.511.0",
    "marked": "^4.1.1",
    "mermaid": "^11.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-fireworks": "^1.0.4",
    "react-i18next": "^13.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.3.0",
    "react-telegram-login": "^1.1.2",
    "react-toastify": "^9.0.8",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sse.js": "^2.6.0",
    "unist-util-visit": "^5.0.0",
    "use-debounce": "^10.0.4"
  },
  "scripts": {
    "dev": "vite",
    "build:image-playground": "cd apps/image-playground && bun install --frozen-lockfile && bun run build",
    "build": "bun run build:image-playground && vite build && bun run prerender",
    "prerender": "node scripts/prerender.mjs",
    "lint": "prettier . --check",
    "lint:fix": "prettier . --write",
    "eslint": "bunx eslint \"**/*.{js,jsx}\" --cache",
    "eslint:fix": "bunx eslint \"**/*.{js,jsx}\" --fix --cache",
    "preview": "vite preview",
    "i18n:extract": "bunx i18next-cli extract",
    "i18n:status": "bunx i18next-cli status",
    "i18n:sync": "bunx i18next-cli sync",
    "i18n:lint": "bunx i18next-cli lint",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "test:video-preflight": "node scripts/video-preflight.test.mjs",
    "test:image-playground-static": "node scripts/image-playground-static-guard.test.mjs",
    "test:model-pricing-currency": "node scripts/model-pricing-currency.test.mjs",
    "test:tiered-billing-display": "node scripts/tiered-billing-display.test.mjs",
    "test:cache-semantics": "node --test scripts/cache-semantics.test.mjs",
    "test:upstream-optimizations": "node scripts/upstream-optimizations.test.mjs && node scripts/playground-account-storage.test.mjs",
    "test:playground-sse": "node scripts/playground-sse.test.mjs",
    "test:ccswitch-config": "node scripts/ccswitch-config.test.mjs",
    "test:runtime-docs": "node --test scripts/runtime-docs.test.mjs",
    "test:desktop-download": "node scripts/desktop-download.test.mjs",
    "test:auth-redirect": "node scripts/auth-redirect.test.mjs",
    "test:world-map-motion": "node --test scripts/world-map-motion.test.mjs",
    "test:request-failure": "node scripts/request-failure.test.mjs",
    "test:pulse-settings": "node scripts/pulse-settings.test.mjs",
    "test:invite-promotion": "bun scripts/invite-promotion.test.mjs",
    "test:invite-promotion:browser": "bun scripts/invite-promotion.browser.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@douyinfe/vite-plugin-semi": "^2.74.0-alpha.6",
    "@so1ve/prettier-config": "^3.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "code-inspector-plugin": "^1.3.3",
    "eslint": "8.57.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "i18next-cli": "^1.10.3",
    "postcss": "^8.5.3",
    "prettier": "^3.0.0",
    "puppeteer-core": "^23.0.0",
    "tailwindcss": "^3",
    "typescript": "4.4.2",
    "vite": "^5.2.0"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true
  },
  "proxy": "http://localhost:3000"
}
